{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m optics.cli:*)",
      "Bash(python -m knowledge.cli:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git worktree list:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(shasum:*)",
      "Bash(du:*)"
    ],
    "deny": [
      "Bash(*ALLOW_MOTION=1*)",
      "Bash(*ALLOW_LASER=1*)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)",
      "Edit(./kb/calibrations/**)",
      "Edit(./SAFETY.md)",
      "Write(./SAFETY.md)"
    ]
  }
}
